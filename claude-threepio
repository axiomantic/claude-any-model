            "name": fallback_name,
            "price_str": item["price_str"],
            "ctx_str": item["ctx_str"],
            "supports1m": item["supports1m"],
            "provider": "openrouter",
            "api_base": None,
            "is_recommended": is_recommended,
            "desc": desc,
        }
    return {
        "id": model_id,
        "raw_model_id": model_id,
        "name": fallback_name,
