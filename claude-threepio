    os.chmod(env_path, 0o600)
    if api_key_to_save:
        success(f"OpenRouter API credentials saved to {env_path}")
    else:
        info("Saved proxy configuration without API key (Free & Local models enabled).")

    # 2. Generate all slot routes & alias mapping
    slot_mappings, alias_map, canonical_names = build_all_slot_mappings(wizard_result["tier_selections"])

    # 3. Write Strict Guardrail & LiteLLM config.yaml
    allowed_models = sorted(set(alias_map.keys()) | canonical_names)

    guardrail_py_path = os.path.join(APP_DIR, "guardrail.py")
    guardrail_code = f"""# Strict Model Guardrail - auto-generated by claude-threepio
# Allows all configured Claude model aliases and routes them to their assigned slot.
import re
from litellm.integrations.custom_logger import CustomLogger
from fastapi import HTTPException

ALLOWED_MODELS = set({json.dumps(list(allowed_models))})
ALIAS_MAP = {json.dumps(alias_map)}

class StrictModelGuardrail(CustomLogger):
    async def async_pre_call_hook(self, user_api_key_dict, cache, data, call_type, **kwargs):
        requested_model = data.get("model")
        if requested_model:
            base_model = re.sub(r'\\[.*?\\]$', '', requested_model).strip()
            canonical = ALIAS_MAP.get(requested_model, ALIAS_MAP.get(base_model, base_model))
            if canonical not in ALLOWED_MODELS and base_model not in ALLOWED_MODELS and requested_model not in ALLOWED_MODELS:
                raise HTTPException(
                    status_code=403,
                    detail=f"[Strict Guardrail] Model '{{requested_model}}' is not permitted. "
                           f"Permitted canonical slots: {{sorted(set(ALIAS_MAP.values()))}}",
                )
            # Rewrite to target slot name for LiteLLM routing
            data["model"] = canonical
        return data

strict_guardrail = StrictModelGuardrail()
"""
    with open(guardrail_py_path, "w", encoding="utf-8") as f:
        f.write(guardrail_code)

    config_yaml_path = os.path.join(APP_DIR, "config.yaml")
    if os.path.exists(config_yaml_path):
        backup_yaml = f"{config_yaml_path}.bak.{int(datetime.now().timestamp())}"
        try:
            with open(config_yaml_path, "r", encoding="utf-8") as src, open(backup_yaml, "w", encoding="utf-8") as dst:
                dst.write(src.read())
        except Exception:
            pass

    yaml_lines = ["model_list:"]

    def write_litellm_params(lines, d):
        prov = d.get("provider", "openrouter")
        mid = d.get("raw_model_id") or d.get("id")
        if prov == "openrouter":
            clean_id = mid[len("openrouter/"):] if mid.startswith("openrouter/") else mid
            lines.append(f"      model: openrouter/{clean_id}")
            lines.append(f"      api_key: os.environ/OPENROUTER_API_KEY")
        elif prov == "ollama":
            clean_id = mid[len("ollama/"):] if mid.startswith("ollama/") else mid
            lines.append(f"      model: ollama/{clean_id}")
            lines.append(f"      api_base: {d.get('api_base') or 'http://localhost:11434'}")
        elif prov in ("openai", "lmstudio", "vllm", "local"):
            clean_id = mid[len("openai/"):] if mid.startswith("openai/") else mid
            lines.append(f"      model: openai/{clean_id}")
            lines.append(f"      api_base: {d.get('api_base') or 'http://localhost:1234/v1'}")
            lines.append(f"      api_key: dummy-key")
        else:
            lines.append(f"      model: {mid}")
            if d.get("api_base"):
                lines.append(f"      api_base: {d['api_base']}")
            lines.append(f"      api_key: dummy-key")

    for slot_item in slot_mappings:
        tname = slot_item["tier"]
        canon = slot_item["canonical"]
        slbl = slot_item["label"]
        d = slot_item["model_entry"]
        mname = d.get("name", d.get("id", ""))
        pstr = d.get("price_str", "")

        yaml_lines.append(f"  # ── [{tname.upper()}] Slot {slot_item['slot_index']}: {canon} ({slbl}) ➔ {mname} ({pstr})")
        for alias in sorted(slot_item["aliases"]):
            yaml_lines.append(f"  - model_name: {alias}")
            yaml_lines.append(f"    litellm_params:")
            write_litellm_params(yaml_lines, d)
            yaml_lines.append("")
            # Also register [1m] and -1m variants
            yaml_lines.append(f"  - model_name: {alias}[1m]")
            yaml_lines.append(f"    litellm_params:")
            write_litellm_params(yaml_lines, d)
            yaml_lines.append("")
            yaml_lines.append(f"  - model_name: {alias}-1m")
            yaml_lines.append(f"    litellm_params:")
            write_litellm_params(yaml_lines, d)
            yaml_lines.append("")

    yaml_lines.append("litellm_settings:")
    yaml_lines.append("  drop_params: true")
    yaml_lines.append("  callbacks:")
    yaml_lines.append("    - guardrail.strict_guardrail\n")
    yaml_lines.append("router_settings:")
    yaml_lines.append("  disable_cooldowns: true")
    yaml_lines.append("  allowed_fails: 100000\n")
    yaml_lines.append("general_settings:")
    yaml_lines.append("  master_key: dummy-key\n")

    with open(config_yaml_path, "w", encoding="utf-8") as f:
        f.write("\n".join(yaml_lines))
    success(f"Generated LiteLLM config at: {config_yaml_path} ({len(slot_mappings)} configured slots)")

    # 4. Configure Sandbox Egress Allowlist
    if wizard_result.get("allow_egress"):
        _set_egress_allowlist(["*"])
        success("Configured network sandbox egress allowlist (allowedEgressHosts: ['*']).")

    # 5. Synchronize Session Histories
    if wizard_result.get("sync_sessions"):
        try:
            sync_sessions_between_modes(silent=True)
            success("Synchronized session histories and groupings between 1P and 3P modes.")
        except Exception:
            pass

    # 6. Write Claude 3P configLibrary JSON
    os.makedirs(CLAUDE_3P_DIR, exist_ok=True)
    meta_path = os.path.join(CLAUDE_3P_DIR, "_meta.json")
    meta = {"appliedId": None, "entries": []}
    if os.path.exists(meta_path):
        try:
            with open(meta_path, "r", encoding="utf-8") as f:
                loaded = json.load(f)
                if isinstance(loaded, dict):
                    meta = loaded
        except Exception:
            pass

    entries = meta.get("entries", [])
    applied_id = meta.get("appliedId")

    # Find existing OpenRouter gateway entry or create a dedicated entry without overwriting others
    gateway_entry = next((e for e in entries if e.get("name") in ("OpenRouter Gateway", "Default") or (applied_id and e.get("id") == applied_id)), None)
    if gateway_entry:
        applied_id = gateway_entry.get("id")
        gateway_entry["name"] = "OpenRouter Gateway"
    else:
        applied_id = str(uuid.uuid4())
        entries.append({"id": applied_id, "name": "OpenRouter Gateway"})

    meta["appliedId"] = applied_id
    meta["entries"] = entries
    with open(meta_path, "w", encoding="utf-8") as f:
