    for key, names in local_engines.items():
        if names:
            label, url = engine_labels.get(key, (key, ""))
            success(f"Local Engine: {label} at {url} is ONLINE ({len(names)} model(s) installed)")

    # Check .env credentials
    env_path = os.path.join(APP_DIR, ".env")
