def build_all_slot_mappings(tier_selections):
    """Generate complete slot mapping list, alias normalization map, and canonical set."""
    all_mappings = []
    alias_map = {}
    canonical_names = set()

    for tier_name, selected_models in tier_selections.items():
        slots = TIER_FAMILY_SLOTS.get(tier_name, [])
        if not selected_models:
            continue

        for idx, model_entry in enumerate(selected_models):
            if idx >= len(slots):
                break
            canon, label, aliases = slots[idx]
            canonical_names.add(canon)
            for a in aliases:
                alias_map[a] = canon
                alias_map[f"{a}[1m]"] = canon
                alias_map[f"{a}-1m"] = canon

            all_mappings.append({
                "tier": tier_name,
                "slot_index": idx + 1,
                "canonical": canon,
                "label": label,
                "aliases": aliases,
                "model_entry": model_entry,
            })

        # Fallback: any remaining unassigned slots in this family route to primary choice
        primary_model = selected_models[0]
        for idx in range(len(selected_models), len(slots)):
            canon, label, aliases = slots[idx]
            canonical_names.add(canon)
            for a in aliases:
                alias_map[a] = canon
                alias_map[f"{a}[1m]"] = canon
                alias_map[f"{a}-1m"] = canon
            all_mappings.append({
                "tier": tier_name,
                "slot_index": idx + 1,
                "canonical": canon,
                "label": label,
                "aliases": aliases,
                "model_entry": primary_model,
            })

    return all_mappings, alias_map, canonical_names

def tui_unified_setup_wizard(tiers, current_config, catalog, initial_step=0):
    """Interactive unified 9-step wizard covering API key, all model tiers, network, session sync, and review."""
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return None

    import curses
    import textwrap

    existing_api_key = find_existing_api_key() or ""
    wizard_state = {
        "api_key": existing_api_key,
        "api_key_mode": "existing" if existing_api_key else "free_only",
        "tier_selections": {},
        "allow_egress": True,
        "sync_sessions": True,
    }

    # Build display items for each model tier
    tier_data = []
    for t_idx, t in enumerate(tiers):
        tname = t["tier_name"]
        all_options = t["options"] + t.get("ollama_options", [])
        
        display_items = []
        # 1. OpenRouter options
        openrouter_opts = [o for o in all_options if o.get("provider") == "openrouter"]
        if openrouter_opts:
            display_items.append({"type": "header", "label": "☁  OpenRouter Cloud"})
            for opt_idx, opt in enumerate(all_options, 1):
                if opt.get("provider") == "openrouter":
                    display_items.append({
                        "type": "model",
                        "num": opt_idx,
                        "data": opt,
                        "is_recommended": bool(opt.get("is_recommended")),
                    })

        # 2. Ollama options
        ollama_opts = [o for o in all_options if o.get("provider") == "ollama"]
        if ollama_opts:
            display_items.append({"type": "header", "label": "⬡  Ollama (Local Inference)"})
            for opt_idx, opt in enumerate(all_options, 1):
                if opt.get("provider") == "ollama":
                    display_items.append({
                        "type": "model",
                        "num": opt_idx,
                        "data": opt,
                        "is_recommended": bool(opt.get("is_recommended")),
                    })

        # 3. Custom options
        custom_openrouter_num = len(all_options) + 1
        custom_local_num = len(all_options) + 2
        display_items.append({"type": "header", "label": "✎  Custom Endpoints"})
        display_items.append({
            "type": "custom_openrouter",
            "num": custom_openrouter_num,
            "label": "Custom OpenRouter model ID",
            "is_recommended": False,
            "data": {
                "name": "Custom OpenRouter Model",
                "id": "custom/model-id",
                "raw_model_id": "custom/model-id",
                "provider": "openrouter",
                "price_str": "Varies by Model",
                "ctx_str": "Auto-detected via API",
                "supports1m": False,
                "desc": "Specify any custom model ID hosted on OpenRouter (e.g. anthropic/claude-3-opus, google/gemini-2.5-pro, deepseek/deepseek-r1)."
            }
        })
        display_items.append({
            "type": "custom_local",
            "num": custom_local_num,
            "label": "Custom local / OpenAI-compatible endpoint",
            "is_recommended": False,
            "data": {
                "name": "Custom Local / OpenAI Endpoint",
                "id": "openai/custom-model",
                "raw_model_id": "openai/custom-model",
                "provider": "local",
                "price_str": "$0.00 / Local",
                "ctx_str": "Local Context",
                "supports1m": False,
                "desc": "Connect to any OpenAI-compatible local server:\n• Ollama (http://localhost:11434)\n• LM Studio (http://localhost:1234/v1)\n• vLLM, LocalAI, Aphrodite, or custom gateway proxies."
            }
        })

        # Detect currently configured model(s) for this tier
        slots = TIER_FAMILY_SLOTS.get(tname, [])
        initial_selected = []
        for canon, label, aliases in slots:
            curr_target = current_config.get(canon)
            if curr_target:
                matched_item = next((it["data"] for it in display_items if it.get("data") and (it["data"]["id"] == curr_target or it["data"].get("raw_model_id") == curr_target)), None)
                if matched_item and matched_item not in initial_selected:
                    initial_selected.append(matched_item)

        if not initial_selected:
            rec_item = next((it["data"] for it in display_items if it.get("is_recommended") and it.get("data")), None)
            if rec_item:
                initial_selected.append(rec_item)
            elif all_options:
                initial_selected.append(all_options[0])

        wizard_state["tier_selections"][tname] = initial_selected
        tier_data.append({
            "tier_idx": t_idx,
            "tier_name": tname,
            "tier_label": t["tier_label"],
            "claude_name": t["claude_name"],
            "display_items": display_items,
            "selectable_indices": [i for i, it in enumerate(display_items) if it["type"] != "header"],
            "max_slots": len(slots),
        })

    step_labels = [
        "1. Key",
        "2. Opus",
        "3. Sonnet",
        "4. Haiku",
        "5. Fable",
        "6. Mythos",
        "7. Network",
        "8. Sync",
        "9. Review"
    ]
    total_steps = len(step_labels)

    def curses_wizard(stdscr):
        curses.curs_set(0)
        curses.use_default_colors()

        try:
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(3, curses.COLOR_GREEN, -1)
            curses.init_pair(4, curses.COLOR_YELLOW, -1)
            curses.init_pair(5, curses.COLOR_MAGENTA, -1)
            curses.init_pair(6, curses.COLOR_BLUE, -1)
        except Exception:
            pass

        try:
            curses.set_escdelay(25)
        except Exception:
            pass

        active_step = max(0, min(initial_step, total_steps - 1))
        selected_idx = 0
        scroll_top = 0
        info_scroll_top = 0
        show_preview = True
        input_num_buf = ""

        while True:
            stdscr.erase()
            max_y, max_x = stdscr.getmaxyx()

            if max_y < 12 or max_x < 70:
                msg = f"Terminal size ({max_x}x{max_y}) is compact. Resize window for Wizard."
                try:
                    stdscr.addstr(0, 0, msg[:max_x-1])
                except Exception:
                    pass
                stdscr.refresh()
                k = stdscr.getch()
                if k in (ord('q'), ord('Q')):
                    return None
                continue

            # Stepper Bar (Line 0)
            cur_x = 1
            for s_i, slbl in enumerate(step_labels):
